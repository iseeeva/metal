{
  "name": "metal",
  "version": "1.0.5",
  "description": "Metal Gear Solid 1 PSX Tools",
  "repository": {
    "url": "git://github.com/iseeeva/metal.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
